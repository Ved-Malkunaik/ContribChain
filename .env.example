# ==============================================================================
# ContribChain Environment Configuration Template
# ==============================================================================

# Protected actions always require real GitHub OAuth and a verified wallet signature.

# 1. Database (Persistent SQLite for local single-instance Node demo)
# SQLite file will persist in contribchain/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Optional Supabase SSR session bridge (platform metadata currently uses Prisma SQLite).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 2. Blockchain / MST Testnet Configuration
# MST Testnet details:
# RPC URL: https://testnetrpc.mstblockchain.com
# Chain ID: 91562037
# Currency: tMSTC
# Explorer: https://testnet.mstscan.com
# Recommended Wallet: BridgeKey Wallet (https://bridgekey.io)
NEXT_PUBLIC_MST_CHAIN_ID="91562037"
NEXT_PUBLIC_MST_RPC_URL="https://testnetrpc.mstblockchain.com"
MST_RPC_URL="https://testnetrpc.mstblockchain.com"

# Address of deployed ContribChainEscrow.sol on MST Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS="0x1f3E1E9Bfe08153c5b3bA7311BB2d74415419a01"
NEXT_PUBLIC_BOUNTY_ADDRESS="0x1f3E1E9Bfe08153c5b3bA7311BB2d74415419a01"
NEXT_PUBLIC_MST_EXPLORER_URL="https://testnet.mstscan.com"
NEXT_PUBLIC_CURRENCY_SYMBOL="tMSTC"
NEXT_PUBLIC_DEPLOYMENT_BLOCK="0"
NEXT_PUBLIC_BOUNTY_DEPLOYMENT_BLOCK="0"

# 3. Application Domain
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. GitHub sign-in credentials
# Use a GitHub OAuth App, or a GitHub App's OAuth Client ID and Client Secret.
# Match the callback URL to APP_URL (local default shown here):
# http://localhost:3000/api/auth/callback/github
# Use the Client ID (not App ID) and Client Secret; the private key is not used for sign-in.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 5. GitHub Repository Webhooks
# Secret configured when setting up repository webhook pointing to /api/webhooks/github
GITHUB_WEBHOOK_SECRET=""

# 6. Optional: server-only token for PR reconciliation and API rate-limit headroom
GITHUB_API_TOKEN=""

# 7. Authentication & Session Secrets
# Generate a unique value for each environment; never use a checked-in example value.
AUTH_SECRET=""
