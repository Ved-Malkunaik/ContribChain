# ==============================================================================
# ContribChain Environment Configuration Template
# ==============================================================================

# Explicit local hackathon simulation: GitHub author/merge are mocked, while
# wallet signatures, escrow deposits, approvals and payouts are real Sepolia.
# Only supported when APP_URL is localhost or 127.0.0.1. Default is disabled.
DEMO_MODE="false"

# 1. Database (Persistent SQLite for local single-instance Node demo)
# SQLite file will persist in contribchain/prisma/dev.db
DATABASE_URL="file:./dev.db"

# 2. Blockchain / Ethereum Sepolia Configuration
NEXT_PUBLIC_SEPOLIA_CHAIN_ID="11155111"
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
# Address of the deployed ContributionBounty.sol contract on Sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
# Block number where the contract was deployed (for bounded event scanning)
NEXT_PUBLIC_DEPLOYMENT_BLOCK="5600000"

# 3. Application Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. GitHub OAuth Application Credentials
# Create at https://github.com/settings/developers
# Authorization Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 5. GitHub Repository Webhooks
# Secret configured when setting up repository webhook pointing to /api/webhooks/github
GITHUB_WEBHOOK_SECRET=""

# 6. Optional: GitHub Personal Access Token (for authenticated REST API calls / rate limit avoidance)
GITHUB_PERSONAL_ACCESS_TOKEN=""

# 7. Authentication & Session Secrets
AUTH_SECRET="contribchain-hackathon-secure-session-secret-2026"
