// Complete ContribChain Prisma Schema with NextAuth, Snapshots, Chain Indexing, and Webhooks
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  wallet       String?
  generation   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WalletLink {
  address  String   @id
  userId   String
  githubId String
  linkedAt DateTime @default(now())
}

model Challenge {
  id         String   @id @default(cuid())
  sessionId  String
  address    String
  message    String
  expires    DateTime
  consumed   Boolean  @default(false)
  generation Int      @default(0)

  @@index([sessionId])
}

model Snapshot {
  id              String   @id @default(cuid())
  kind            String   // "project" | "opportunity"
  owner           String   // publisher address (lowercase)
  canonical       String   // canonical JSON string
  hash            String   @unique
  uri             String
  repoId          String?
  parentId        String?
  chainRef        String?  // on-chain ID string
  transactionHash String?
  published       Boolean  @default(false)
  chainAddress    String   @default("")
  createdAt       DateTime @default(now())

  @@index([kind, published])
}

model VerifiedSubmission {
  id              String   @id @default(cuid())
  opportunityId   String
  wallet          String
  githubId        String
  repoId          String
  prNumber        Int
  reference       String
  url             String
  title           String
  login           String
  notes           String
  prState         String   // "open" | "closed" | "merged"
  commit          String
  syncedAt        DateTime
  nextSyncAt      DateTime
  syncError       String?
  transactionHash String?
  chainRef        String?
  chainAddress    String   @default("")
  createdAt       DateTime @default(now())

  @@index([repoId, prNumber])
  @@index([opportunityId, wallet])
}

model ChainEvent {
  id              String   @id @default(cuid())
  chainId         Int
  transactionHash String
  logIndex        Int
  blockNumber     String
  eventName       String
  payload         String
  contractAddress String   @default("")

  @@unique([chainId, transactionHash, logIndex])
}

model Checkpoint {
  id    String @id
  block String
}

model Transaction {
  hash            String   @id
  wallet          String
  status          String
  blockNumber     String?
  contractAddress String   @default("")
  updatedAt       DateTime @updatedAt
}

model WebhookDelivery {
  id         String   @id
  status     String
  receivedAt DateTime @default(now())
}

model Project {
  id                  String        @id @default(cuid())
  onChainId           Int?          @unique
  publisherAddress    String
  name                String
  shortDescription    String
  detailedDescription String
  category            String
  technologies        String        // JSON array string
  repoId              String        // Canonical "owner/repo"
  repoUrl             String
  liveDappUrl         String
  demoVideoUrl        String?
  metadataURI         String?
  metadataHash        String?
  txHash              String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  opportunities       Opportunity[]
}

model Opportunity {
  id                   String       @id @default(cuid())
  onChainId            Int?         @unique
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publisherAddress     String
  title                String
  taskType             String       // bug | feature | documentation | optimization | security
  description          String
  acceptanceCriteria   String
  difficulty           String       // Beginner | Intermediate | Advanced
  requiredSkills       String       // JSON array string
  rewardEth            String       // Display string (e.g. "0.5")
  rewardWei            String       // Exact integer wei string (e.g. "500000000000000000")
  deadline             DateTime
  issueUrl             String?
  metadataURI          String?
  metadataHash         String?
  state                String       @default("OPEN") // OPEN | APPROVED | PAID | REFUNDED
  selectedSubmissionId String?
  txHash               String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  submissions          Submission[]
}

model Submission {
  id                 String       @id @default(cuid())
  onChainId          Int?         @unique
  opportunityId      String
  opportunity        Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contributorAddress String
  githubUsername     String?
  githubUserId       String?
  prUrl              String
  prNumber           Int
  repoOwner          String
  repoName           String
  notes              String?
  status             String       @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  isMerged           Boolean      @default(false)
  mergedAt           DateTime?
  latestCommitSha    String?
  isRewardReady      Boolean      @default(false)
  txHash             String?
  paidTxHash         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}
